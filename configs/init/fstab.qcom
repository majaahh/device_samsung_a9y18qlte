system                                   /system                ext4   ro,barrier=1,discard   wait
system_ext                               /system_ext            ext4   ro,barrier=1,discard   wait
product                                  /product               ext4   ro,barrier=1,discard   wait
odm                                      /odm                   ext4   ro,barrier=1,discard   wait
vendor                                   /vendor                ext4   ro,barrier=1,discard   wait

/dev/block/by-name/boot                  /boot                  emmc   defaults               recoveryonly
/dev/block/by-name/recovery              /recovery              emmc   defaults               recoveryonly
/dev/block/by-name/vbmeta                /vbmeta                emmc   defaults               recoveryonly

/dev/block/by-name/cache                 /cache                 ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check
/dev/block/bootdevice/by-name/userdata   /data                  ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic	wait,check,forceencrypt=footer,quota,reservedsize=128M

/dev/block/by-name/efs                   /efs                   ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check
/dev/block/bootdevice/by-name/misc       /misc                  emmc   defaults                                                                                 defaults

/devices/soc/c084000.sdhci/mmc_host*                            auto   vfat        defaults    voldmanaged=sdcard:auto
/devices/soc/a800000.ssusb/a800000.dwc3/xhci-hcd.0.auto*        auto   auto        defaults    voldmanaged=usb:auto
